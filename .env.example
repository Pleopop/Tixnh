# Vercel Postgres — dùng biến Vercel inject (thường là POSTGRES_URL)
# Nếu Vercel/Neon cung cấp POSTGRES_PRISMA_URL (pooled), ưu tiên dùng cho serverless
POSTGRES_URL="postgresql://user:pass@host/db?sslmode=require"
# Admin JWT (generate: openssl rand -base64 32)
JWT_SECRET="your-long-random-secret"

# CORS — domain admin SPA (có thể nhiều origin, cách nhau bởi dấu phẩy)
ADMIN_ORIGINS="https://tinhx-admin.vercel.app"
# Hoặc dùng một biến: ADMIN_ORIGIN="https://tinhx-admin.vercel.app"
# Seed script (local only — set real values on Vercel for first deploy seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme"
